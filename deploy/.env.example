# Copie ce fichier en « .env » (à côté de docker-compose.yml) et remplis-le. Ne le publie jamais.
TS_AUTHKEY=tskey-auth-...
HUB_ADMIN=admin
# Obligatoire : le compose refuse de démarrer sans lui. Choisis 12 caractères au moins (un mot de passe plus court est accepté mais le serveur le signale au démarrage). Il ne sert qu'à créer le premier compte.
# Tailscale (avec Funnel, voir serve.json) est le seul accès distant : le hub est alors visible d'Internet, ce mot de passe est sa seule défense.
HUB_PASSWORD=remplace-moi-par-un-vrai-mot-de-passe
TMDB_KEY=
APPS=/mnt/tank/apps/media
MEDIA=/mnt/tank/media
